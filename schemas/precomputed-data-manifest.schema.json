{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DCDC precomputed probability data manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "dataRevision",
    "distributionSize",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "dataRevision": {
      "type": "integer",
      "minimum": 1
    },
    "distributionSize": {
      "const": 1024
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "bytes",
          "sha256"
        ],
        "properties": {
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
