{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DCDC precomputed probability data",
  "type": "object",
  "required": [
    "schemaVersion",
    "dataRevision",
    "dataset",
    "distributionSize",
    "shard",
    "index",
    "distributions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "dataRevision": {
      "type": "integer",
      "minimum": 1
    },
    "dataset": {
      "enum": [
        "dx",
        "dr",
        "d10",
        "livingdead"
      ]
    },
    "distributionSize": {
      "enum": [
        1024,
        2048
      ]
    },
    "shard": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "index": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/index"
      }
    },
    "distributions": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/sparseDistribution"
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/$defs/sparseDistribution"
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "index": {
      "type": "object",
      "required": [
        "start",
        "count"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "sparseDistribution": {
      "type": "object",
      "required": [
        "offset",
        "values"
      ],
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2047
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2048,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "dataset": {
            "const": "dx"
          }
        }
      },
      "then": {
        "properties": {
          "distributionSize": {
            "const": 2048
          },
          "shard": {
            "type": "object",
            "required": [
              "shihai"
            ],
            "properties": {
              "shihai": {
                "type": "integer",
                "minimum": 0,
                "maximum": 19
              }
            },
            "additionalProperties": false
          },
          "index": {
            "type": "object",
            "required": [
              "dice",
              "critical"
            ],
            "properties": {
              "dice": {
                "const": {
                  "start": 0,
                  "count": 100
                }
              },
              "critical": {
                "const": {
                  "start": 2,
                  "count": 10
                }
              }
            },
            "additionalProperties": false
          },
          "distributions": {
            "type": "array",
            "minItems": 100,
            "maxItems": 100,
            "items": {
              "type": "array",
              "minItems": 10,
              "maxItems": 10,
              "items": {
                "$ref": "#/$defs/sparseDistribution"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "dataset": {
            "const": "dr"
          }
        }
      },
      "then": {
        "properties": {
          "distributionSize": {
            "const": 2048
          },
          "shard": {
            "type": "object",
            "required": [
              "kazanari"
            ],
            "properties": {
              "kazanari": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9
              }
            },
            "additionalProperties": false
          },
          "index": {
            "const": {
              "dice": {
                "start": 0,
                "count": 203
              }
            }
          },
          "distributions": {
            "type": "array",
            "minItems": 203,
            "maxItems": 203,
            "items": {
              "$ref": "#/$defs/sparseDistribution"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "dataset": {
            "const": "d10"
          }
        }
      },
      "then": {
        "properties": {
          "distributionSize": {
            "const": 1024
          },
          "shard": {
            "const": {}
          },
          "index": {
            "const": {
              "dice": {
                "start": 0,
                "count": 224
              }
            }
          },
          "distributions": {
            "type": "array",
            "minItems": 224,
            "maxItems": 224,
            "items": {
              "$ref": "#/$defs/sparseDistribution"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "dataset": {
            "const": "livingdead"
          }
        }
      },
      "then": {
        "properties": {
          "distributionSize": {
            "const": 1024
          },
          "shard": {
            "const": {}
          },
          "index": {
            "const": {
              "dice": {
                "start": 0,
                "count": 224
              }
            }
          },
          "distributions": {
            "type": "array",
            "minItems": 224,
            "maxItems": 224,
            "items": {
              "$ref": "#/$defs/sparseDistribution"
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
