{
  "name": "double-cross-dice-calculator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "data:generate": "node scripts/generate-precomputed-data.mjs",
    "data:check": "node scripts/generate-precomputed-data.mjs --check",
    "data:regenerate": "uv run --project generator dx-precompute generate",
    "data:verify-generator": "uv run --project generator dx-precompute verify",
    "generator:lint": "uv run --project generator ruff check generator",
    "generator:test": "uv run --project generator pytest",
    "lint": "eslint .",
    "lint:markdown": "markdownlint-cli2",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "chartjs-plugin-annotation": "^3.1.0",
    "chartjs-plugin-datalabels": "^2.2.0",
    "vue": "^3.5.40",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^4.6.4",
    "vuetify": "^3.12.11",
    "webfontloader": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mdi/js": "^7.4.47",
    "@vitejs/plugin-vue": "6.0.8",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^16.5.0",
    "markdownlint-cli2": "0.23.2",
    "sass": "^1.102.0",
    "vite": "8.1.5",
    "vite-plugin-vuetify": "2.1.3",
    "vitest": "4.1.10",
    "wrangler": "^4.114.0"
  }
}
